# Pulse Mini App API — пример конфига
# Скопируй в .env и заполни под нужный сервер

# Путь к базе бота, к которому привязан Mini App
# dev-сервер (root/dev):
DATABASE_PATH=/root/dev/database/bot_database.db
# продакшн (после перехода на прод):
# DATABASE_PATH=/root/prod/database/bot_database.db

# Окружение: development | production
APP_ENV=development

# Разрешённые источники CORS (домен вашего Mini App)
# Для локального теста достаточно строки ниже, на проде замени на реальный https-адрес
MINI_APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
